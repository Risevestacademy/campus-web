# PostHog project tokens are public, write-only ingestion identifiers.
# Use the development project for local, preview, and staging environments.
# Use the production project only for production deployments.
# Both variables are required when CI=true or VERCEL=1.
# Locally, leaving the token empty disables analytics.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Server-only Campus API origin. Never expose this as NEXT_PUBLIC_*.
# On Railway, prefer http://<service>.railway.internal:<port> at runtime.
CAMPUS_API_BASE_URL=
